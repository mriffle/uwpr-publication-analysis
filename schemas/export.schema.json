{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uwpr-pubs.local/schemas/export.schema.json",
  "title": "export/uwpr_publications.json — the app's data contract (docs/05-metrics-and-data-contract.md §4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "run_id",
    "pipeline_version",
    "rule_version",
    "resource",
    "sources",
    "period",
    "summary",
    "method",
    "funding",
    "works"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "generated_at": {"$ref": "common.schema.json#/$defs/datetime"},
    "run_id": {"type": "string", "minLength": 1},
    "pipeline_version": {"type": "string", "minLength": 1},
    "rule_version": {"$ref": "common.schema.json#/$defs/ruleVersion"},
    "resource": {"$ref": "#/$defs/resource"},
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citations", "notes"],
      "properties": {
        "citations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "as_of"],
          "properties": {
            "name": {"const": "OpenAlex"},
            "as_of": {"$ref": "common.schema.json#/$defs/date"}
          }
        },
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "period": {"$ref": "#/$defs/period"},
    "summary": {"$ref": "#/$defs/summary"},
    "method": {"$ref": "#/$defs/method"},
    "funding": {"$ref": "#/$defs/funding"},
    "works": {"type": "array", "items": {"$ref": "#/$defs/work"}}
  },
  "$defs": {
    "person": {
      "description": "A member of the resource's staff. `id` is the join key: it is the same identifier that works[].authors[].staff and works[].staff_authors carry, so the app can turn one into a name (docs/05 §4.2).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "openalex"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/staffKey"},
        "name": {"type": "string"},
        "openalex": {"type": ["string", "null"]}
      }
    },
    "namedPerson": {
      "description": "Someone named on a publication who is not part of the resource, so has no staff identifier.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "openalex"],
      "properties": {
        "name": {"type": "string"},
        "openalex": {"type": ["string", "null"]}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "short_name", "url", "identifier", "home_institution", "home_country", "exclusions", "staff"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "short_name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "identifier": {"type": "string", "minLength": 1},
        "home_institution": {
          "description": "The institution this resource belongs to. docs/05 §7.8's chart excludes it; the app is told which one rather than taking the most frequent, which would silently start charting the home institution if it ever fell below the threshold.",
          "type": "object",
          "additionalProperties": false,
          "required": ["ror", "name"],
          "properties": {
            "ror": {"$ref": "common.schema.json#/$defs/ror"},
            "name": {"type": "string", "minLength": 1}
          }
        },
        "home_country": {
          "description": "The ISO 3166-1 alpha-2 country the resource sits in. docs/05 §7.14 counts works with an author outside it, and leaves it out of the country bar.",
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "exclusions": {
          "description": "What is deliberately not evidence, named (docs/05 §10). The method page groups these by `kind` and shows each with its note; it carries no such names of its own, because §1.1 principle 5 keeps everything resource-specific in this file.",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/exclusion"}
        },
        "staff": {"type": "array", "items": {"$ref": "#/$defs/person"}}
      }
    },
    "exclusion": {
      "description": "One thing that looks like evidence and is deliberately not counted as any. `kind` groups it on the method page; `note` says why it does not count, factually and without judgement (docs/05 §10, §11).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "note"],
      "properties": {
        "kind": {"enum": ["facility", "software", "tool", "hardware"]},
        "name": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_year",
        "last_year",
        "complete_through",
        "current_year_partial",
        "citation_years_from",
        "citations_before_window"
      ],
      "properties": {
        "first_year": {"type": "integer"},
        "last_year": {"type": "integer"},
        "complete_through": {"type": "integer"},
        "current_year_partial": {"type": "boolean"},
        "citation_years_from": {"type": ["integer", "null"]},
        "citations_before_window": {"type": "integer", "minimum": 0}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publications",
        "first_year",
        "last_year",
        "citations",
        "citations_in_window",
        "fwci_median",
        "fwci_mean",
        "h_index",
        "open_access",
        "journals",
        "institutions",
        "countries",
        "research_groups",
        "last_authors",
        "on_official_list",
        "beyond_official_list",
        "preprint_only"
      ],
      "properties": {
        "publications": {"type": "integer", "minimum": 0},
        "first_year": {"type": "integer"},
        "last_year": {"type": "integer"},
        "citations": {"type": "integer", "minimum": 0},
        "citations_in_window": {"type": "integer", "minimum": 0},
        "fwci_median": {"type": ["number", "null"], "minimum": 0},
        "fwci_mean": {"type": ["number", "null"], "minimum": 0},
        "h_index": {"type": "integer", "minimum": 0},
        "open_access": {"type": "integer", "minimum": 0},
        "journals": {"type": "integer", "minimum": 0},
        "institutions": {"type": "integer", "minimum": 0},
        "countries": {"type": "integer", "minimum": 0},
        "research_groups": {"type": "integer", "minimum": 0},
        "last_authors": {"type": "integer", "minimum": 0},
        "on_official_list": {"type": "integer", "minimum": 0},
        "beyond_official_list": {"type": "integer", "minimum": 0},
        "preprint_only": {"type": "integer", "minimum": 0}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria",
        "works_with_multiple_criteria",
        "official_list_total",
        "independently_confirmed",
        "listing_only",
        "listing_only_text_read",
        "listing_only_text_unavailable",
        "beyond_official_list",
        "works_with_staff_author",
        "sources_last_read"
      ],
      "properties": {
        "criteria": {
          "type": "object",
          "propertyNames": {"enum": ["1", "2", "3", "4"]},
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "works_with_multiple_criteria": {"type": "integer", "minimum": 0},
        "official_list_total": {"type": "integer", "minimum": 0},
        "independently_confirmed": {"type": "integer", "minimum": 0},
        "listing_only": {"type": "integer", "minimum": 0},
        "listing_only_text_read": {"type": "integer", "minimum": 0},
        "listing_only_text_unavailable": {"type": "integer", "minimum": 0},
        "beyond_official_list": {"type": "integer", "minimum": 0},
        "works_with_staff_author": {"type": "integer", "minimum": 0},
        "sources_last_read": {
          "type": "object",
          "additionalProperties": {"$ref": "common.schema.json#/$defs/date"}
        }
      }
    },
    "institution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ror", "name", "country"],
      "properties": {
        "ror": {"$ref": "common.schema.json#/$defs/ror"},
        "name": {"type": ["string", "null"]},
        "country": {"type": ["string", "null"]}
      }
    },
    "ids": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doi", "pmid", "pmcid", "openalex"],
      "properties": {
        "doi": {"oneOf": [{"$ref": "common.schema.json#/$defs/doi"}, {"type": "null"}]},
        "pmid": {"oneOf": [{"$ref": "common.schema.json#/$defs/pmid"}, {"type": "null"}]},
        "pmcid": {"oneOf": [{"$ref": "common.schema.json#/$defs/pmcid"}, {"type": "null"}]},
        "openalex": {"type": ["string", "null"]}
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "openalex",
        "orcid",
        "staff",
        "corresponding",
        "institutions",
        "affiliations_raw"
      ],
      "properties": {
        "name": {"type": "string"},
        "openalex": {"type": ["string", "null"]},
        "orcid": {"oneOf": [{"$ref": "common.schema.json#/$defs/orcid"}, {"type": "null"}]},
        "staff": {
          "oneOf": [{"$ref": "common.schema.json#/$defs/staffKey"}, {"type": "null"}]
        },
        "corresponding": {"type": "boolean"},
        "institutions": {"type": "array", "items": {"$ref": "#/$defs/institution"}},
        "affiliations_raw": {"type": "array", "items": {"type": "string"}}
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "field", "subfield", "topic", "score", "primary"],
      "properties": {
        "domain": {"type": "string"},
        "field": {"type": "string"},
        "subfield": {"type": "string"},
        "topic": {"type": "string"},
        "score": {"type": "number"},
        "primary": {"type": "boolean"}
      }
    },
    "citations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "by_year", "fwci", "percentile", "as_of"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "by_year": {
          "type": "object",
          "propertyNames": {"pattern": "^[0-9]{4}$"},
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "fwci": {"type": ["number", "null"], "minimum": 0},
        "percentile": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "as_of": {"$ref": "common.schema.json#/$defs/date"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "criterion",
        "label",
        "section",
        "excerpt",
        "source",
        "detail",
        "first_seen",
        "last_seen"
      ],
      "properties": {
        "rule": {"enum": ["R1", "R2", "R3", "R3d", "R4", "R5", "R6", "R7", "override"]},
        "criterion": {"type": ["integer", "null"], "enum": [1, 2, 3, 4, null]},
        "label": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1},
        "excerpt": {"type": ["string", "null"], "maxLength": 400},
        "found_on": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "doi"],
          "properties": {
            "kind": {"$ref": "common.schema.json#/$defs/includedKind"},
            "doi": {"oneOf": [{"$ref": "common.schema.json#/$defs/doi"}, {"type": "null"}]}
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url", "retrieved"],
          "properties": {
            "name": {"type": "string"},
            "url": {"type": ["string", "null"]},
            "retrieved": {"$ref": "common.schema.json#/$defs/date"}
          }
        },
        "detail": {"type": "object"},
        "first_seen": {"$ref": "common.schema.json#/$defs/date"},
        "last_seen": {"$ref": "common.schema.json#/$defs/date"}
      },
      "allOf": [
        {
          "comment": "Override evidence belongs to the work, not a record, so it names no version.",
          "if": {"properties": {"rule": {"const": "override"}}, "required": ["rule"]},
          "then": {"not": {"required": ["found_on"]}},
          "else": {"required": ["found_on"]}
        },
        {
          "comment": "An override is a judgement: the app shows it attributed and dated (docs/05 §6).",
          "if": {"properties": {"rule": {"const": "override"}}, "required": ["rule"]},
          "then": {
            "properties": {
              "detail": {
                "required": ["by", "date"],
                "properties": {
                  "by": {"type": "string", "minLength": 1},
                  "date": {"$ref": "common.schema.json#/$defs/date"}
                }
              }
            }
          }
        }
      ]
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "doi", "date", "year", "url"],
      "properties": {
        "kind": {"$ref": "common.schema.json#/$defs/includedKind"},
        "doi": {"oneOf": [{"$ref": "common.schema.json#/$defs/doi"}, {"type": "null"}]},
        "date": {"oneOf": [{"$ref": "common.schema.json#/$defs/date"}, {"type": "null"}]},
        "year": {"type": "integer"},
        "url": {"type": ["string", "null"]}
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "aliases",
        "title",
        "year",
        "date",
        "first_version_date",
        "kind",
        "is_preprint",
        "venue",
        "ids",
        "url",
        "oa",
        "retracted",
        "authors",
        "author_count",
        "staff_authors",
        "institutions",
        "countries",
        "corresponding_authors",
        "topics",
        "citations",
        "on_official_list",
        "criteria",
        "evidence",
        "versions",
        "grants"
      ],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/workId"},
        "aliases": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/workId"}},
        "title": {"type": "string"},
        "year": {"type": "integer"},
        "date": {"oneOf": [{"$ref": "common.schema.json#/$defs/date"}, {"type": "null"}]},
        "first_version_date": {
          "oneOf": [{"$ref": "common.schema.json#/$defs/date"}, {"type": "null"}]
        },
        "kind": {"$ref": "common.schema.json#/$defs/includedKind"},
        "is_preprint": {"type": "boolean"},
        "venue": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["name", "issn_l"],
          "properties": {
            "name": {"type": "string"},
            "issn_l": {"type": ["string", "null"]}
          }
        },
        "ids": {"$ref": "#/$defs/ids"},
        "url": {"type": ["string", "null"]},
        "oa": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "url", "license"],
          "properties": {
            "status": {
              "enum": ["gold", "green", "hybrid", "bronze", "diamond", "closed", "unknown"]
            },
            "url": {"type": ["string", "null"]},
            "license": {"type": ["string", "null"]}
          }
        },
        "retracted": {"type": "boolean"},
        "authors": {"type": "array", "items": {"$ref": "#/$defs/author"}},
        "author_count": {"type": "integer", "minimum": 0},
        "staff_authors": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/staffKey"},
          "uniqueItems": true
        },
        "institutions": {"type": "array", "items": {"$ref": "#/$defs/institution"}},
        "countries": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "corresponding_authors": {"type": "array", "items": {"$ref": "#/$defs/namedPerson"}},
        "topics": {"type": "array", "items": {"$ref": "#/$defs/topic"}},
        "citations": {"$ref": "#/$defs/citations"},
        "on_official_list": {"type": "boolean"},
        "criteria": {
          "type": "array",
          "items": {"enum": [1, 2, 3, 4]},
          "uniqueItems": true
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "versions": {"type": "array", "items": {"$ref": "#/$defs/version"}},
        "grants": {
          "description": "The grants this work lists, sorted by grant; empty when it lists none or the export carries no funding data (docs/09 §11.2)",
          "type": "array",
          "items": {"$ref": "#/$defs/grantListing"}
        }
      }
    },
    "grantListing": {
      "description": "One grant on one work (docs/09 §11.2). `cited_as` and `override` are present only where they apply.",
      "type": "object",
      "additionalProperties": false,
      "required": ["grant", "how", "agencies"],
      "properties": {
        "grant": {"description": "A key in funding.grants; never null: an unresolved number is a MISC: grant", "$ref": "common.schema.json#/$defs/grantKey"},
        "how": {
          "description": "The strongest evidence that the paper names the grant: the first of listed, corrected, override, nih_link",
          "enum": ["listed", "nih_link", "corrected", "override"]
        },
        "cited_as": {
          "description": "The written forms on this work that reached the grant only by correction or override, whitespace collapsed, sorted; present exactly when there are any, whatever `how` is",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "override": {"$ref": "#/$defs/grantOverride"},
        "agencies": {
          "description": "The grant's agency chain, root first, so a filter needs nothing but the row",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/agencyCode"}
        }
      }
    },
    "grantOverride": {
      "description": "Who decided a string on this work is this grant, and why: present exactly when a grant override applied",
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "by", "date"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "by": {"type": "string", "minLength": 1},
        "date": {"$ref": "common.schema.json#/$defs/date"}
      }
    },
    "funding": {
      "description": "The funding behind the publications (docs/09 §11.3). `version` is null exactly when this export carries no funding data; then every list is empty and every count zero.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "as_of", "sources", "exchange_rates", "method", "summary", "agencies", "grants"],
      "properties": {
        "version": {"oneOf": [{"$ref": "common.schema.json#/$defs/ruleVersion"}, {"type": "null"}]},
        "as_of": {
          "description": "The date of the last full refresh: every amount was read then or later",
          "oneOf": [{"$ref": "common.schema.json#/$defs/date"}, {"type": "null"}]
        },
        "sources": {"type": "array", "items": {"$ref": "#/$defs/fundingSource"}},
        "exchange_rates": {"type": "array", "items": {"$ref": "#/$defs/exchangeRates"}},
        "method": {"$ref": "#/$defs/fundingMethod"},
        "summary": {"$ref": "#/$defs/fundingSummary"},
        "agencies": {"description": "Every agency a grant names, with every parent, sorted by code", "type": "array", "items": {"$ref": "#/$defs/agency"}},
        "grants": {"description": "Every grant an exported work lists, sorted by key", "type": "array", "items": {"$ref": "#/$defs/grant"}}
      }
    },
    "fundingSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "as_of", "amounts_from", "partial_year"],
      "properties": {
        "id": {"enum": ["reporter", "nsf", "usaspending", "openalex", "pubmed", "crossref", "pmc"]},
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "as_of": {"description": "The latest date a fact from this source was confirmed", "$ref": "common.schema.json#/$defs/date"},
        "amounts_from": {"description": "The first year the source's amounts cover, where they start somewhere", "type": ["integer", "null"]},
        "partial_year": {"description": "The fiscal year in progress on as_of, for a source reported by fiscal year", "type": ["integer", "null"]}
      }
    },
    "exchangeRates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "currencies", "through_year"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "currencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{3}$"}},
        "through_year": {"type": "integer"}
      }
    },
    "fundingMethod": {
      "description": "Distinct (work, string) pairs over the exported works, by outcome and by method, for the method page",
      "type": "object",
      "additionalProperties": false,
      "required": ["strings", "resolution", "works_without_funding_metadata"],
      "properties": {
        "strings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grant", "unresolved", "not_a_grant", "resource_code", "facility_contract"],
          "properties": {
            "grant": {"type": "integer", "minimum": 0},
            "unresolved": {"type": "integer", "minimum": 0},
            "not_a_grant": {"type": "integer", "minimum": 0},
            "resource_code": {"type": "integer", "minimum": 0},
            "facility_contract": {"type": "integer", "minimum": 0}
          }
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exact", "normalised", "corrected", "override"],
          "properties": {
            "exact": {"type": "integer", "minimum": 0},
            "normalised": {"type": "integer", "minimum": 0},
            "corrected": {"type": "integer", "minimum": 0},
            "override": {"type": "integer", "minimum": 0}
          }
        },
        "works_without_funding_metadata": {"type": "integer", "minimum": 0}
      }
    },
    "fundingSummary": {
      "description": "Computed from the rows, with institution-wide awards included, for the cross-check (docs/09 §11.6)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grants",
        "grants_resolved",
        "grants_with_amount",
        "grants_unconverted",
        "grants_institution_wide",
        "agencies",
        "investigators",
        "organizations",
        "amount_usd",
        "amount_usd_institution_wide",
        "amount_usd_nih",
        "nih_grants",
        "works_with_grants",
        "works_with_listings",
        "first_year",
        "last_year",
        "by_first_year"
      ],
      "properties": {
        "grants": {"type": "integer", "minimum": 0},
        "grants_resolved": {"type": "integer", "minimum": 0},
        "grants_with_amount": {"type": "integer", "minimum": 0},
        "grants_unconverted": {"type": "integer", "minimum": 0},
        "grants_institution_wide": {"type": "integer", "minimum": 0},
        "agencies": {"type": "integer", "minimum": 0},
        "investigators": {"type": "integer", "minimum": 0},
        "organizations": {"type": "integer", "minimum": 0},
        "amount_usd": {"type": "integer", "minimum": 0},
        "amount_usd_institution_wide": {"type": "integer", "minimum": 0},
        "amount_usd_nih": {"type": "integer", "minimum": 0},
        "nih_grants": {"type": "integer", "minimum": 0},
        "works_with_grants": {"type": "integer", "minimum": 0},
        "works_with_listings": {"type": "integer", "minimum": 0},
        "first_year": {"type": ["integer", "null"]},
        "last_year": {"type": ["integer", "null"]},
        "by_first_year": {
          "description": "Resolved grants by their first year: the cumulative rule's increments",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {"^[0-9]{4}$": {"$ref": "#/$defs/fundingYear"}}
        }
      }
    },
    "fundingYear": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grants", "grants_institution_wide", "amount_usd", "amount_usd_institution_wide"],
      "properties": {
        "grants": {"type": "integer", "minimum": 0},
        "grants_institution_wide": {"type": "integer", "minimum": 0},
        "amount_usd": {"type": "integer", "minimum": 0},
        "amount_usd_institution_wide": {"type": "integer", "minimum": 0}
      }
    },
    "agency": {
      "description": "An agency (docs/09 §11.5). The app finds Miscellaneous by `group`, never by a key.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "short_name", "parent", "group", "country"],
      "properties": {
        "code": {"$ref": "common.schema.json#/$defs/agencyCode"},
        "name": {"type": "string", "minLength": 1},
        "short_name": {"type": ["string", "null"]},
        "parent": {"oneOf": [{"$ref": "common.schema.json#/$defs/agencyCode"}, {"type": "null"}]},
        "group": {"enum": ["us_federal", "us_nonfederal", "non_us", "miscellaneous"]},
        "country": {"description": "ISO 3166 alpha-2", "oneOf": [{"type": "string", "pattern": "^[A-Z]{2}$"}, {"type": "null"}]}
      }
    },
    "grant": {
      "description": "A grant (docs/09 §11.4)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "agency",
        "number",
        "category",
        "scope",
        "scope_reason",
        "status",
        "title",
        "pis",
        "organization",
        "start_year",
        "end_year",
        "first_year",
        "amount_usd",
        "amount_original",
        "currency",
        "rate_year",
        "amount_source",
        "fiscal_years",
        "url",
        "url_name",
        "flags"
      ],
      "properties": {
        "key": {"$ref": "common.schema.json#/$defs/grantKey"},
        "agency": {"description": "The most specific agency: an NIH grant's administering IC", "$ref": "common.schema.json#/$defs/agencyCode"},
        "number": {"description": "The display form", "type": "string", "minLength": 1},
        "category": {"enum": ["research", "center", "training", "instrument", "contract", "other"]},
        "scope": {"enum": ["project", "institution-wide"]},
        "scope_reason": {"description": "Why it is institution-wide; null for a project", "type": ["string", "null"]},
        "status": {"description": "unresolved exactly for a MISC: grant", "enum": ["resolved", "unresolved"]},
        "title": {"description": "As the source gives it; RePORTER's are often capitals", "type": ["string", "null"]},
        "pis": {"description": "As the funder's public record gives them", "type": "array", "items": {"$ref": "#/$defs/investigator"}},
        "organization": {"type": ["string", "null"]},
        "start_year": {"type": ["integer", "null"]},
        "end_year": {"type": ["integer", "null"]},
        "first_year": {"description": "The year of the earliest exported work that lists it", "type": ["integer", "null"]},
        "amount_usd": {"description": "Whole US dollars; null when unknown or unconverted, never 0 for unknown", "type": ["integer", "null"], "minimum": 0},
        "amount_original": {"description": "In `currency`", "type": ["number", "null"]},
        "currency": {"description": "ISO 4217", "oneOf": [{"type": "string", "pattern": "^[A-Z]{3}$"}, {"type": "null"}]},
        "rate_year": {"description": "The exchange rate's year, when converted", "type": ["integer", "null"]},
        "amount_source": {"oneOf": [{"$ref": "#/$defs/amountSource"}, {"type": "null"}]},
        "fiscal_years": {
          "description": "Sums by fiscal year, RePORTER only; a year whose rows report no amount is null. The years with amounts sum to amount_usd.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {"^[0-9]{4}$": {"type": ["integer", "null"]}}
            },
            {"type": "null"}
          ]
        },
        "url": {"description": "A page a reader can open to check the grant", "type": ["string", "null"]},
        "url_name": {"description": "The link's label, naming the page it opens; null exactly when url is", "type": ["string", "null"]},
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "active",
              "starts_before_fy1985",
              "starts_before_fy2008",
              "no_amount_reported",
              "amount_not_found",
              "amount_from_openalex",
              "amount_corrected",
              "amounts_disagree",
              "unconverted_currency",
              "rate_year_estimated"
            ]
          }
        }
      }
    },
    "investigator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "id": {"description": "RePORTER's profile_id; null where the source gives no identifier", "type": ["string", "null"]}
      }
    },
    "amountSource": {
      "description": "Where a grant's amount comes from: the page is the grant's url, the date the store line's `checked`",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "as_of", "basis"],
      "properties": {
        "name": {"enum": ["NIH RePORTER", "NSF Award API", "USAspending", "OpenAlex"]},
        "url": {"type": ["string", "null"]},
        "as_of": {"$ref": "common.schema.json#/$defs/date"},
        "basis": {
          "enum": [
            "reporter_fiscal_years",
            "reporter_contract",
            "reporter_task_order",
            "nsf_obligated",
            "nsf_estimated",
            "usaspending_obligation",
            "openalex_amount"
          ]
        }
      }
    }
  }
}
