{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uwpr-pubs.local/schemas/config/exchange_rates.schema.json",
  "title": "Exchange rates: config/exchange_rates.yaml (docs/09-funding-impact.md §7.2, F7). Outside the funding fingerprint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sources", "rates"],
  "properties": {
    "schema": {"const": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "dataset", "retrieved", "years", "currencies"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "dataset": {"description": "Exactly which release or dataset the rates were read from", "type": "string", "minLength": 1},
          "retrieved": {"$ref": "../common.schema.json#/$defs/date"},
          "years": {"description": "[first, last]", "type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}},
          "currencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/currency"}}
        }
      }
    },
    "rates": {
      "description": "US dollars per unit, by currency and year, as decimal strings",
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/currency"},
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {"pattern": "^[0-9]{4}$"},
        "additionalProperties": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}
      }
    }
  },
  "$defs": {
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
  }
}
