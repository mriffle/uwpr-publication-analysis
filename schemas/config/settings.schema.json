{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uwpr-pubs.local/schemas/config/settings.schema.json",
  "title": "Pipeline settings: config/settings.yaml (docs/03-retrieval-pipeline.md §10.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contact", "window_start", "resource", "official_list", "openalex", "rate_limits",
               "max_attempts", "recheck_days", "last_seen_refresh_days", "list_drop_tolerance", "recall_baseline",
               "recall_alert_points", "degraded_to_alert_after", "timezone_for_dates"],
  "properties": {
    "schema": {"const": 1},
    "resource": {
      "description": "What the app calls the facility it describes. The app holds no UWPR-specific text of its own (docs/05 §1.1 principle 5), so every name and link it shows comes from here through export/.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "short_name", "url", "home_institution", "home_country", "exclusions"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "short_name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "home_institution": {
          "description": "The institution the facility belongs to, which docs/05 §7.8's chart excludes. Stated here because the app must not infer it from frequency.",
          "type": "object",
          "additionalProperties": false,
          "required": ["ror", "name"],
          "properties": {
            "ror": {"description": "ROR ID without the https://ror.org/ prefix, matching works[].institutions[].ror", "$ref": "../common.schema.json#/$defs/ror"},
            "name": {"description": "As the affiliation source names it, so the chart's note and the data agree", "type": "string", "minLength": 1}
          }
        },
        "home_country": {
          "description": "ISO 3166-1 alpha-2 code the facility sits in; docs/05 §7.14 counts authors outside it.",
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "exclusions": {
          "description": "What is deliberately not evidence, named (docs/05 §10). Restates in public terms what rules.yaml already excludes, because principle 5 forbids the app naming any of them itself. The register is factual and carries no judgement (docs/05 §11).",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/exclusion"}
        }
      }
    },
    "contact": {
      "description": "Sent to APIs as mailto/email/User-Agent contact. Fixed by project rule: no other personal address is ever sent (Phase 1 §7).",
      "const": "mriffle@uw.edu"
    },
    "window_start": {"type": "integer", "minimum": 1990, "maximum": 2100},
    "official_list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index_url", "page_link_pattern"],
      "properties": {
        "index_url": {"type": "string", "pattern": "^https://proteomicsresource\\.washington\\.edu/"},
        "page_link_pattern": {"description": "Regex for links from the index to the year and 'older' pages", "type": "string", "minLength": 1}
      }
    },
    "openalex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_run_usd", "min_remaining_usd"],
      "properties": {
        "max_run_usd": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "min_remaining_usd": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "rate_limits": {
      "description": "Requests per second per source (§7)",
      "type": "object",
      "additionalProperties": false,
      "required": ["ncbi", "ncbi_with_key", "europepmc", "openalex", "crossref", "pride", "biorxiv", "uwpr_site"],
      "properties": {
        "ncbi": {"$ref": "#/$defs/rate"},
        "ncbi_with_key": {"$ref": "#/$defs/rate"},
        "europepmc": {"$ref": "#/$defs/rate"},
        "openalex": {"$ref": "#/$defs/rate"},
        "crossref": {"$ref": "#/$defs/rate"},
        "pride": {"$ref": "#/$defs/rate"},
        "biorxiv": {"$ref": "#/$defs/rate"},
        "uwpr_site": {"$ref": "#/$defs/rate"}
      }
    },
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
    "recheck_days": {"type": "integer", "minimum": 1},
    "last_seen_refresh_days": {"type": "integer", "minimum": 1},
    "list_drop_tolerance": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "recall_baseline": {
      "description": "Recall on the official list at calibration (Phase 1 §4.2)",
      "type": "object",
      "additionalProperties": false,
      "required": ["with_evidence", "assessable"],
      "properties": {
        "with_evidence": {"type": "integer", "minimum": 0},
        "assessable": {"type": "integer", "minimum": 1}
      }
    },
    "recall_alert_points": {"type": "number", "exclusiveMinimum": 0},
    "degraded_to_alert_after": {"type": "integer", "minimum": 1},
    "timezone_for_dates": {"const": "UTC"}
  },
  "$defs": {
    "rate": {"type": "number", "exclusiveMinimum": 0, "maximum": 50},
    "exclusion": {
      "description": "One thing that looks like evidence and is not counted as any, grouped on the method page by `kind`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "note"],
      "properties": {
        "kind": {"enum": ["facility", "software", "tool", "hardware"]},
        "name": {"description": "As a reader would recognise it", "type": "string", "minLength": 1},
        "note": {"description": "A short factual sentence saying why it does not count", "type": "string", "minLength": 1}
      }
    }
  }
}
