{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uwpr-pubs.local/schemas/run.schema.json",
  "title": "Run manifest: store/runs/<run-id>.json (docs/02-data-model.md §11)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "mode", "started", "ended", "code_version", "config_fingerprint",
               "rule_version", "channels", "rules", "official_list_recall", "fixtures", "changes", "api"],
  "properties": {
    "schema": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-(incremental|full|sample)$"},
    "mode": {"enum": ["incremental", "full", "sample"]},
    "started": {"$ref": "common.schema.json#/$defs/datetime"},
    "ended": {"$ref": "common.schema.json#/$defs/datetime"},
    "code_version": {"type": "string"},
    "config_fingerprint": {"$ref": "common.schema.json#/$defs/cacheRef"},
    "rule_version": {"$ref": "common.schema.json#/$defs/ruleVersion"},
    "note": {"type": "string"},
    "channels": {
      "type": "object",
      "propertyNames": {"$ref": "common.schema.json#/$defs/channel"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["queries", "nominated", "new", "errors"],
        "properties": {
          "queries": {"type": "integer", "minimum": 0},
          "nominated": {"type": "integer", "minimum": 0},
          "new": {"type": "integer", "minimum": 0},
          "errors": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "rules": {
      "type": "object",
      "propertyNames": {"enum": ["R1", "R2", "R3", "R3d", "R4", "R5", "R6", "R7", "override"]},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["works", "new"],
        "properties": {"works": {"type": "integer", "minimum": 0}, "new": {"type": "integer", "minimum": 0}}
      }
    },
    "official_list_recall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessable", "with_evidence"],
      "properties": {
        "assessable": {"type": "integer", "minimum": 0},
        "with_evidence": {"type": "integer", "minimum": 0}
      }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": {"enum": ["pass", "fail", "known_miss"]}
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed", "merged", "list_appeared", "list_disappeared"],
      "properties": {
        "added": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/workId"}},
        "removed": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["work", "reason"],
            "properties": {"work": {"$ref": "common.schema.json#/$defs/workId"}, "reason": {"type": "string"}}
          }
        },
        "merged": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["into", "retired"],
            "properties": {"into": {"$ref": "common.schema.json#/$defs/workId"}, "retired": {"$ref": "common.schema.json#/$defs/workId"}}
          }
        },
        "list_appeared": {"type": "array", "items": {"type": "string"}},
        "list_disappeared": {"type": "array", "items": {"type": "string"}}
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["calls", "cost_usd"],
        "properties": {"calls": {"type": "integer", "minimum": 0}, "cost_usd": {"type": "number", "minimum": 0}}
      }
    }
  }
}
